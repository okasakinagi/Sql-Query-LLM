# 复制为 .env 后按需修改；不要提交 .env 到版本库
# 复制命令：copy .env.example .env   （PowerShell: Copy-Item .env.example .env）

# ---------------------------------------------------------------- MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=erp_demo
DB_CHARSET=utf8mb4

# ------------------------------------- 大模型服务（任意 OpenAI 兼容接口）
# llama.cpp 默认 http://127.0.0.1:8080/v1
# Ollama 默认    http://127.0.0.1:11434/v1
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=qwen2.5-coder-7b-instruct
LLM_API_KEY=not-needed
LLM_TIMEOUT=120
LLM_TEMPERATURE=0.0

# ------------------------------------------------------------ 查询与安全
QUERY_TIMEOUT=10
MAX_RETRY=2
MAX_RESULT_ROWS=2000
ANSWER_PREVIEW_ROWS=30

# ------------------------------------------------------------------- Web
WEB_HOST=127.0.0.1
WEB_PORT=8000

# ------------------------------------------------------------- 数据生成
SEED=20260910
